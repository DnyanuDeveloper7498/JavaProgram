class Population
{
    public static void main(String[] args)
    {
        double currPop = 312_032_486;

        double seconds = 365* 24 * 60 * 60; // 1 year

        double BIRTH = seconds / 7;
        double DEATH = seconds / 13;
        double IMMIGRANTS = seconds / 45;

        double yearlyIncrease = BIRTH - DEATH + IMMIGRANTS;

        System.out.println("Previous Population: " + (long)currPop);

        for (int i = 1; i <= 5; i++)
        {
            currPop += yearlyIncrease;
            System.out.println("After " + i + " year: " + currPop);
        }
    }
}
