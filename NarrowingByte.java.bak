class NarrowingByte
{
	public static void main(String[] args) 
	{
		
		 
		 short s =150;
		 System.out.println(s);//150
	     byte b1 =(byte)s;
	     System.out.println(b1); //-106  (short)
		 
		
		 char ch ='A';
		 System.out.println(ch);// A
		 
		 byte b6=(byte)ch;
		 System.out.println(b6); // 65 (char)
		 
	     int i = 32768;
		  System.out.println(i);// 32768
	     byte b2=(byte)i;
	     System.out.println(b2); // 0  (int)
		 
		 long l1=200l;
		 System.out.println(l1); // 200
		 byte b3=(byte)l1;
		 System.out.println(b3);//  -56 (long)
		 
		 float f1= 10.50f;
		 System.out.println(f1);//10.5
		 byte b4=(byte)f1;
		 System.out.println(b4); // 10 (float)
		 
		 
		 double d1 = 55.66;
		 
		 System.out.println(d1);
		 byte b5=(byte)d1;
	     System.out.println(b5); //55 (double)
		 
		
	}
	
}
