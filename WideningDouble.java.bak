class WideningDouble {
    public static void main(String[] args) {

        byte b = 10;
        double d1 = b;
        System.out.println(d1); // 10.0

        short s = 300;
        double d2 = s;
        System.out.println(d2); // 300.0

        char ch = 'A';
        double d3 = ch;
        System.out.println(d3); // 65.0

        int i = 1000;
        double d4 = i;
        System.out.println(d4); // 1000.0

        long l = 50000L;
        double d5 = l;
        System.out.println(d5); // 50000.0

        float f = 10.5f;
        double d6 = f;
        System.out.println(d6); // 10.5
    }
}
