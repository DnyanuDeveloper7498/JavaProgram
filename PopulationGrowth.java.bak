/*Q Population Growth

Ek city ki population 1,200,000 hai.

1 birth every 10 seconds

1 death every 20 seconds

1 immigrant every 40 seconds
Ek saal ke liye population calculate karo aur next 3 years ka output print karo.*/


class PopulationGrowth 
{
	public static void main(String[] args) 
	{
		
		long currentPop=1200000;
	
		
        long second = (365*24*60*60); 
		
	 
		
		final long BIRTH = second /10;
			
	    final long DEATH = second/20;
		
		 final long IMMIGRANT = second /40;
		  
		 long newPop =  BIRTH - DEATH + IMMIGRANT ;
		 
		for (int i=1;i<=5 ;i++ )
		 {
			    currentPop += newPop;
			
			 System.out.println("After "+ i +" Year: "+ currentPop);  
			
		  }
		  	
	}
}




